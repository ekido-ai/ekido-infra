(secure) {
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Base Sepolia: the coordinator under /sepolia (port 8003) and its dashboard on 3101.
# ekido.xyz is the site. api.ekido.xyz is the API and provider domain only: it serves /sepolia and
# /deploy, and redirects everything else to ekido.xyz. The coordinator allows the ekido.xyz origin
# through CORS_ORIGINS in /etc/ekido/coordinator.env.
# The site itself calls the API on its own host (https://SITE_HOST/sepolia), so nothing it loads is cross-site:
# browser shields that block cross-site requests and WebSockets (Brave's, for one) don't break it. Providers and
# agents keep using API_HOST.
# The host names come from /etc/ekido/site.env (SITE_HOST, API_HOST) through a caddy drop-in, and default to the
# live names, so a staging server serves the same layout under its own names.
# EXTRA_HOSTS in site.env adds more names that serve the same thing, for moving to a new domain without turning the old one off.
# It starts with a comma: EXTRA_HOSTS=", example.com, api.example.com". Empty by default. A name needs its DNS record first.
{$API_HOST:api.ekido.xyz}, {$SITE_HOST:ekido.xyz}{$EXTRA_HOSTS:} {
	import secure
	encode gzip
	# The commit the server is running, published by infra/server/ops/ekido-autodeploy.sh.
	handle_path /deploy/* {
		@version path /version.json
		handle @version {
			header Cache-Control "no-store"
			root * /var/lib/ekido-autodeploy/public
			file_server
		}
		respond 404
	}
	# Send the two inference endpoints to the model router; other /v1 routes stay on Platform.
	handle /sepolia/v1/* {
		uri strip_prefix /sepolia
		@inference path_regexp inference ^/v1/(chat/completions|models/[A-Za-z0-9_-]+/predict)$
		handle @inference {
			reverse_proxy 127.0.0.1:8020
		}
		handle {
			reverse_proxy 127.0.0.1:8010
		}
	}
	handle_path /sepolia/* {
		reverse_proxy 127.0.0.1:8003
	}
	@apihost host {$API_HOST:api.ekido.xyz}
	handle @apihost {
		redir https://{$SITE_HOST:ekido.xyz}{uri} 308
	}
	handle {
		reverse_proxy 127.0.0.1:3101
	}
}
